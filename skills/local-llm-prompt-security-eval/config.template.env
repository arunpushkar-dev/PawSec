# Ollama Configuration Template
# Copy this file to .env and update with your settings

# Ollama API URL
# Default: http://localhost:11434/api/chat
OLLAMA_URL=http://localhost:11434/api/chat

# Default model to use for classification
# Recommended: qwen2.5-finetuned (fine-tuned for 6-parameter security output)
# Alternatives: llama2, mistral, codellama (not recommended - may fail validation)
OLLAMA_MODEL=qwen2.5-finetuned

# Note: If these are not set, the skill will ask you interactively
